# AGY v2 — single source of truth for app-level constants.
# Sourced by build/lib/paths.sh AND parsed by build/tools/gen_android_config.py.
# Plain KEY=VALUE, no spaces around '='. Do not add shell logic here.

PKG=com.agy
PKG_DEV=com.agy.dev
APP_NAME=Antigravity
APP_NAME_DEV=Antigravity Dev
PORT=45157
PORT_DEV=45158
OAUTH_SCHEME=antigravity
# App package version (must match the release tag v<APP_VERSION_NAME>).
APP_VERSION_NAME=2.3.0
APP_VERSION_CODE=15

# Upstream core/runtime version is separate from the Android app version.
CORE_VERSION=2.11.0
MIN_API=24
TARGET_SDK=28
