# Signing identities. Release signing is selected only from protected environment
# variables by build/lib/signing.sh. Never put release secrets in this file.
# Dev keystores are generated locally and are intentionally ignored by Git.
DEV_KEYSTORE="${AGY_DEV_KEYSTORE:-$PROJECT/tools/debug.keystore}"
DEV_KEY_ALIAS="${AGY_DEV_KEY_ALIAS:-androiddebugkey}"
DEV_KEY_PASS="${AGY_DEV_KEY_PASS:-android}"
DEV_STORE_PASS="${AGY_DEV_STORE_PASS:-android}"

# Release signing inputs are mandatory for non-dev builds.
KEYSTORE="${AGY_RELEASE_KEYSTORE:-}"
KEY_ALIAS="${AGY_RELEASE_KEY_ALIAS:-}"
KEY_PASS="${AGY_RELEASE_KEY_PASS:-}"
STORE_PASS="${AGY_RELEASE_STORE_PASS:-}"
