# AGY v2 — modular project paths and host toolchain specification.
#
# Reference paths for modular architecture (v2.4+)

PROJECT_ROOT="${PROJECT_ROOT:-${PROJECT:-$PWD}}"

# Heavy runtime inputs (modules/core)
CORE_ARCHIVE="${CORE_ARCHIVE:-$PROJECT_ROOT/modules/core/pristine/language_server.tar.gz}"
GLIBC_DIR="${GLIBC_DIR:-$PROJECT_ROOT/modules/core/glibc}"
CERTS_DIR="${CERTS_DIR:-$PROJECT_ROOT/modules/core/certs}"
SEED_DIR="${SEED_DIR:-$PROJECT_ROOT/modules/core/seed}"
SHIMS_DIR="${SHIMS_DIR:-$PROJECT_ROOT/modules/core/shims}"

# Bionic toolchain layer (project-local in v2)
ENV_DIR="${PROJECT:-$AGY_HOME}/env"
ENV_DIST="${ENV_DIST:-$PROJECT/env/dist/env}"

# Host toolchain jars
ANDROID_JAR="${ANDROID_JAR:-$AGY_HOME/tools/android.jar}"
R8_JAR="${R8_JAR:-$AGY_HOME/tools/r8.jar}"
ANDROID_JAR_SHA256="${ANDROID_JAR_SHA256:-4fade8d5e04130bd8ccd74d5fec6c86b01ad75c3ee877ccc5d660255c4c78646}"
R8_JAR_SHA256="${R8_JAR_SHA256:-a1d7f902d56cfa8d1e8cd64aa250e63549359fcd096eb793286787b1a1e76db1}"
